NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
# Public base URL of this API (used to build media/signed URLs)
API_PUBLIC_URL=http://localhost:4000

BACKEND_FRAMEWORK=express        # express | hapi

DATABASE_TYPE=mysql              # mysql | mongodb
ORM_PROVIDER=prisma              # prisma | drizzle (mysql) ; prisma | mongoose (mongodb)
DATABASE_URL=mysql://root:password@localhost:3306/art_gallery
MONGODB_URL=mongodb://localhost:27017/art_gallery

JWT_ACCESS_SECRET=replace_me_with_64_random_chars
JWT_REFRESH_SECRET=replace_me_with_another_64_random_chars
JWT_ACCESS_TTL=15m
# lax (frontend and API on the same site) | none (frontend on another domain; HTTPS required)
COOKIE_SAMESITE=lax
REFRESH_TOKEN_TTL_DAYS=30
# HMAC secret for signed private-file URLs
FILE_SIGNING_SECRET=replace_me_with_64_random_chars

STORAGE_PROVIDER=local           # local | s3
LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=                 # optional, for S3-compatible storage (R2, MinIO, Spaces)

REDIS_ENABLED=false
REDIS_URL=

PAYMENT_PROVIDER=cod             # cod | manual (razorpay | stripe | payu planned)
DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY=IN
DEFAULT_TIMEZONE=Asia/Kolkata
COMMISSION_DEFAULT_PERCENTAGE=10
DIGITAL_DOWNLOAD_LIMIT=5
DIGITAL_DOWNLOAD_EXPIRY_DAYS=30

AI_PROVIDER=none                 # none (pluggable ImageGenerationProvider)

# Seed admin (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@artgallery.local
SEED_ADMIN_PASSWORD=Admin@12345
# Demo gallery content: default on in development, off in production unless true
SEED_DEMO=true
